# Root allowlist: new areas must be added deliberately.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/pyproject.toml
!/src/
!/examples/
!/docs/
!/tests/

# Local migration notes and all operational or personal state.
/local/
/var/
/applications/
/materials/
/profiles/
.env
.env.*
!.env.example
**/__pycache__/
**/*.py[cod]
**/.venv*/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.db
**/*.sqlite*
**/*.eml
**/*.mbox
**/*.log
**/credentials.json
**/client_secret*.json
**/token.json
**/*.pem
**/*.key
**/.auth/
**/.browser/
